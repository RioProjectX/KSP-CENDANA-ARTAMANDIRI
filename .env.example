# Aplikasi ini sudah otomatis terhubung ke Firebase Cloud Firestore melalui firebase-applet-config.json.
# Semua variabel di bawah ini bersifat OPSIONAL (tidak wajib diisi agar aplikasi berjalan).

# SESSION_SECRET: (Opsional) Kunci acak untuk menandatangani token sesi login PIN.
SESSION_SECRET=""

# FIREBASE_WORKSPACE_KEY: (Opsional) Nama workspace khusus di Firestore.
FIREBASE_WORKSPACE_KEY=""
